	-test -z "$(v4l2_request_drv_video_la_LTLIBRARIES)" || rm -f $(v4l2_request_drv_video_la_LTLIBRARIES)
	@list='$(v4l2_request_drv_video_la_LTLIBRARIES)'; \
	locs=`for p in $$list; do echo $$p; done | \
	      sed 's|^[^/]*$$|.|; s|/[^/]*$$||; s|$$|/so_locations|' | \
	      sort -u`; \
	test -z "$$locs" || { \
	  echo rm -f $${locs}; \
	  rm -f $${locs}; \
	}

