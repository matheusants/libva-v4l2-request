	  echo " $(MKDIR_P) '$(DESTDIR)$(v4l2_request_drv_video_ladir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(v4l2_request_drv_video_ladir)" || exit 1; \
	  echo " $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 '$(DESTDIR)$(v4l2_request_drv_video_ladir)'"; \
	  $(LIBTOOL) $(AM_LIBTOOLFLAGS) $(LIBTOOLFLAGS) --mode=install $(INSTALL) $(INSTALL_STRIP_FLAG) $$list2 "$(DESTDIR)$(v4l2_request_drv_video_ladir)"; \
	}

