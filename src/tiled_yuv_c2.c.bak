#include <stdint.h>
#include <string.h>

void tiled_to_planar(uint8_t *src, uint8_t *dst, uint32_t dst_pitch,
                      uint32_t width, uint32_t height) {
    // No T527, o stride do hardware para tiles costuma ser alinhado a 128
    // ou mantido em múltiplos de 32 dependendo do kernel.
    uint32_t stride = (width + 31) & ~31;
    uint32_t tiles_per_row = stride / 32;
    const uint32_t tile_size = 1024; // 32x32

    for (uint32_t ty = 0; ty < height; ty++) {
        uint32_t tile_y_idx = ty / 32;
        uint32_t in_tile_y  = ty % 32;
        uint8_t *dst_line   = dst + (ty * dst_pitch);

        for (uint32_t tx = 0; tx < tiles_per_row; tx++) {
            uint32_t x_pos = tx * 32;
            if (x_pos >= width) continue;

            // Localização exata do bloco na memória Cedrus
            uint8_t *tile_base = src + (tile_y_idx * tiles_per_row + tx) * tile_size;
            uint8_t *src_ptr   = tile_base + (in_tile_y * 32);

            uint32_t bytes_to_copy = (width - x_pos < 32) ? (width - x_pos) : 32;
            memcpy(dst_line + x_pos, src_ptr, bytes_to_copy);
        }
    }
}
